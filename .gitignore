# Superseded; queries without USER_MODE
force-app/main/default/classes/GenericRecordContextProvider.cls*

# Ground on apex://RecordContextProvider
force-app/main/default/classes/AgentforceCaseSummaryController.cls*
force-app/main/default/classes/AgentforceCaseSummaryControllerTest.cls*
force-app/main/default/lwc/agentforceCaseSummary/

# Unrelated features that happen to share this folder (SAS fee handling)
force-app/main/default/classes/SASPaymentFeeBatchHelper.cls*
force-app/main/default/classes/SASPsiClearedFeeHandler.cls*

# Prompt templates: Morning_Brief was removed 2026-08-18 with the stored-brief
